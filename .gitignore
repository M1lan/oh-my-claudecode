# Release body is generated dynamically — never commit stale copies
.github/release-body.md

# Build artifacts — generated by `pnpm run build`, never commit
dist/
bridge/
pnpm-workspace.yaml

# pnpm is the only supported package manager — never commit npm/yarn lockfiles
package-lock.json
npm-shrinkwrap.json
yarn.lock

__pycache__/
*.py[cod]
.forks/
